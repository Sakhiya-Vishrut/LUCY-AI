<Window x:Class="LucyAI.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LucyAI.UI.Controls"
        mc:Ignorable="d"
        Title="LUCY AI — JARVIS OS"
        WindowState="Maximized"
        WindowStyle="None"
        Topmost="True"
        Background="#000000"
        Foreground="#00FF66">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Neon green glass card border ───────────────────────────── -->
        <Style x:Key="EmeraldGlassBorder" TargetType="Border">
            <Setter Property="Background"        Value="#EE020B06"/>
            <Setter Property="BorderBrush"       Value="#00FF66"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="14"/>
        </Style>

        <!-- ── Exit / header button ───────────────────────────────────── -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#CC020B06"/>
            <Setter Property="Foreground"      Value="#00FF66"/>
            <Setter Property="BorderBrush"     Value="#00FF66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="#FF052210"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="#FF10FF7B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Left nav button ────────────────────────────────────────── -->
        <!--
            Each nav button passes its Tag as the page name to NavigateCommand.
            IsSelected is driven by a DataTrigger that compares Tag to ActivePage.
        -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#66FF99"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="#22007744"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active nav item — bright neon highlight -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground"  Value="#00FF66"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Background"  Value="#33004422"/>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         ROOT GRID  (3 columns: left-nav | main-content | right-status)
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="#000000">
        <Grid.ColumnDefinitions>
            <!-- Left navigation sidebar — always visible -->
            <ColumnDefinition Width="Auto"/>
            <!-- Centre — hologram OR module page -->
            <ColumnDefinition Width="*"/>
            <!-- Future: right status panel (phase 17) -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Top HUD bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main area -->
            <RowDefinition Height="*"/>
            <!-- Bottom subtitle / mic bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP HUD BAR (spans full width) ══════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource EmeraldGlassBorder}"
                Padding="16,8" Margin="16,12,16,0"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side: identity + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#00FF66"
                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LUCY AI"
                               FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text=" | " FontSize="11" Foreground="#446644"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemStatusLabel}"
                               FontSize="11" Foreground="#00E65C"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text=" | WAKE WORD: '"
                               FontSize="11" Foreground="#446644"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="LUCY"
                               FontSize="11" Foreground="#00FF66"
                               VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="' | MODEL: "
                               FontSize="11" Foreground="#446644"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveModel}"
                               FontSize="11" Foreground="#00FF66"
                               VerticalAlignment="Center" FontWeight="Bold"/>
                    <!-- Battery / Internet (live from SystemMetricsService) -->
                    <TextBlock Text=" | "
                               FontSize="11" Foreground="#446644"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding BatteryStatus}"
                               FontSize="11" Foreground="#88FF99"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Margin="12,0,4,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInternetConnected}" Value="True">
                                        <Setter Property="Fill" Value="#00FF66"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding IsInternetConnected,
                                     Converter={x:Null},
                                     FallbackValue='NET'}"
                               FontSize="10" Foreground="#446644"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right side: clock + exit -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemTime}"
                               FontSize="13" Foreground="#00FF66"
                               FontFamily="Consolas" FontWeight="Bold"
                               Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <Button Content="✕ EXIT"
                            Click="OnExitAppClick"
                            Style="{StaticResource ExitButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ LEFT NAVIGATION SIDEBAR ═════════════════════════════════ -->
        <!--
            EXPLANATION:
            Each Button calls NavigateCommand with its page name as parameter.
            The active page is highlighted by comparing Tag to ActivePage in
            the code-behind (UpdateNavButtons is called from MainWindow.xaml.cs).

            Voice equivalent:  "Lucy open memory"  → NavigateCommand("Memory")
        -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#0A0A0A"
                BorderBrush="#1A3322"
                BorderThickness="0,0,1,0"
                Padding="8,16,8,16"
                Width="160">
            <!-- WPF does not have StackPanel.Spacing — use Margin on each child instead -->
            <StackPanel VerticalAlignment="Top">

                <!-- Section label -->
                <TextBlock Text="NAVIGATION"
                           FontSize="9" Foreground="#334433"
                           FontFamily="Consolas" FontWeight="Bold"
                           Margin="14,0,0,8"/>

                <!-- Home — shows the 3D hologram -->
                <Button x:Name="NavHome"
                        Content="⬡  Home"
                        Tag="Home"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Home"/>

                <Button x:Name="NavAssistant"
                        Content="◈  Assistant"
                        Tag="Assistant"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Voice"/>

                <Button x:Name="NavMemory"
                        Content="◉  Memory"
                        Tag="Memory"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Memory"/>

                <Button x:Name="NavFiles"
                        Content="◫  Files"
                        Tag="Files"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Files"/>

                <Button x:Name="NavBrowser"
                        Content="◬  Browser"
                        Tag="Browser"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Browser"/>

                <Button x:Name="NavVision"
                        Content="◭  Vision"
                        Tag="Vision"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Vision"/>

                <Button x:Name="NavAutomation"
                        Content="⚙  Automation"
                        Tag="Automation"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Automation"/>

                <Button x:Name="NavApps"
                        Content="▦  Apps"
                        Tag="Apps"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Apps"/>

                <Button x:Name="NavControl"
                        Content="⛭  Control"
                        Tag="Control"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Control"/>

                <!-- Separator -->
                <Border Height="1" Background="#1A3322" Margin="8,8,8,8"/>

                <Button x:Name="NavSettings"
                        Content="✦  Settings"
                        Tag="Settings"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Settings"/>

                <Button x:Name="NavDeveloper"
                        Content="&lt;/&gt; Developer"
                        Tag="Developer"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,1,0,1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Developer"/>

                <!-- Separator -->
                <Border Height="1" Background="#1A3322" Margin="8,8,8,8"/>

                <!-- CPU / RAM live mini-stats in sidebar footer -->
                <TextBlock Text="SYSTEM"
                           FontSize="9" Foreground="#334433"
                           FontFamily="Consolas" FontWeight="Bold"
                           Margin="14,0,0,4"/>

                <StackPanel Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="CPU " FontSize="10" Foreground="#446644"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}"
                                   FontSize="10" Foreground="#00FF66"
                                   FontFamily="Consolas" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RAM " FontSize="10" Foreground="#446644"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}"
                                   FontSize="10" Foreground="#00FF66"
                                   FontFamily="Consolas" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ CENTRE — HOLOGRAM or MODULE PAGE ═══════════════════════ -->
        <!--
            Both layers live in the same Grid cell.
            The hologram is always rendered (it is the background).
            The ModuleViews overlay is Visible only when ActivePage != "Home".
            This gives a "glass panel slides over the sphere" effect.
        -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Layer 1: 3D Particle Hologram (always present) -->
            <controls:LucyParticleHologramControl
                AssistantState="{Binding AssistantState}"
                AudioVolume="{Binding AudioVolume}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

            <!-- Subtle footer text over the hologram -->
            <TextBlock Text="[+] JARVIS VOICE OS ACTIVE | CONTINUOUS SPEECH ENGINE RUNNING"
                       Foreground="#00FF66" FontSize="10" FontWeight="Bold"
                       Opacity="0.55"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,14"
                       IsHitTestVisible="False"/>

            <!-- Layer 2: Module page overlay (hidden when Home) -->
            <!--
                Visibility bound to IsPageOverlayVisible (bool property on ViewModel).
                When true a semi-transparent dark glass panel covers the hologram
                and the ModuleViews UserControl renders the active page content.
            -->
            <Border Background="#E8010804"
                    Visibility="{Binding IsPageOverlayVisible, Converter={StaticResource BoolToVis}}">
                <controls:ModuleViews
                    x:Name="ModuleViewsControl"
                    ActivePage="{Binding ActivePage}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <!-- ═══ BOTTOM BAR (subtitle + mic state) ════════════════════== -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <!-- Left spacer matching nav sidebar -->
                <ColumnDefinition Width="160"/>
                <!-- Centre: subtitle toast -->
                <ColumnDefinition Width="*"/>
                <!-- Right: mic state pill -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Subtitle toast (auto-hides after 2.5 s) -->
            <Border Grid.Column="1"
                    Background="#F0020B06"
                    BorderBrush="#00FF66"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="28,12"
                    MaxWidth="780"
                    Visibility="{Binding IsSubtitleVisible, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding SubtitleText}"
                           Foreground="#FFFFFF"
                           FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontFamily="Consolas, Segoe UI"/>
            </Border>

            <!-- Mic state pill (click to toggle listening) -->
            <Button Grid.Column="2"
                    Command="{Binding ToggleVoiceListeningCommand}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Border Background="#EE020B06"
                        BorderBrush="#00FF66"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10"
                                 Fill="#00FF66"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="STATE: "
                                   Foreground="#446644"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AssistantState}"
                                   Foreground="#00FF66"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
    </Grid>
</Window>
